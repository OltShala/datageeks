    "name": "Record Staff Reply In Memory",
    "parameters": {
     "operation": "executeQuery",
     "query": "INSERT INTO n8n_chat_memory (session_id, message)\nSELECT $1, jsonb_build_object('type','ai','content',$2::text,'tool_calls','[]'::jsonb,\n       'additional_kwargs','{}'::jsonb,'response_metadata','{}'::jsonb,'invalid_tool_calls','[]'::jsonb)\n WHERE NOT $3::boolean AND length(btrim($4::text)) > 0",
     "options": {
      "queryReplacement": "={{ [ 'acct' + $('Staff In').first().json.accountId + ':' + (((((($json.body.conversation || {}).meta || {}).sender || {}).phone_number || '').replace('+','')) || ((((($json.body.conversation || {}).meta || {}).sender || {}).id) ? ('contact-' + $json.body.conversation.meta.sender.id) : ('conv-' + $json.body.conversation.id))), '[Reply from our staff member ' + ((($json.body.sender || {}).name) || 'our team') + ']: ' + ($json.body.content || ''), !!$json.body.private, ($json.body.content || '') ] }}"
     }
    },
