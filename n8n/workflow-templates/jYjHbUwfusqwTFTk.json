   {
    "id": "em-parse",
    "name": "Parse Input",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     220,
     0
    ],
    "parameters": {
     "jsCode": "const inp = $input.first().json || {};\nlet d = inp;\nif (typeof inp.query === 'string') { try { d = JSON.parse(inp.query); } catch (e) { d = inp; } }\nelse if (inp.query && typeof inp.query === 'object') { d = inp.query; }\nreturn [{ json: d }];"
    }
   },
   {
    "id": "em-send",
    "name": "Send via Resend",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.2,
    "position": [
     440,
     0
    ],
    "parameters": {
     "method": "POST",
     "url": "https://api.resend.com/emails",
     "authentication": "genericCredentialType",
     "genericAuthType": "httpHeaderAuth",
     "sendHeaders": true,
     "headerParameters": {
      "parameters": [
       {
        "name": "Content-Type",
        "value": "application/json"
       }
      ]
     },
     "sendBody": true,
     "specifyBody": "json",
     "jsonBody": "={{ JSON.stringify({ from: 'Receply <support@receply.net>', to: [$json.to], subject: $json.subject, text: $json.message }) }}",
     "options": {}
    },
    "credentials": {
     "httpHeaderAuth": {
      "id": "DjRkKR2CfiOZ60Uu",
      "name": "Resend API (support@receply.net)"
     }
    },
    "onError": "continueRegularOutput"
   },
   {
    "id": "em-return",
    "name": "Return",
    "type": "n8n-nodes-base.set",
    "typeVersion": 3.4,
