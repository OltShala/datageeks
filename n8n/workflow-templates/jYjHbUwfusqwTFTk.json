       {
        "id": "651bfbb3-c56e-4d95-a1f5-426ec3950344",
        "name": "result",
        "type": "string",
        "value": "={{ $json.id ? ('Email sent to ' + $('Parse Input').item.json.to + ' from support@receply.net.') : ('Email NOT sent to ' + $('Parse Input').item.json.to + ': ' + String(($json.error && ($json.error.message || $json.error)) || 'unknown error').slice(0, 160)) }}"
       },
       {
        "id": "5c9dd5d7-d553-44f4-9c2b-e40e7488f40c",
        "name": "sent",
